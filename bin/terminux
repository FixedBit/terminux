#!/data/data/com.termux/files/usr/bin/bash
# =============================================================================
#  terminux -- control CLI for the Termux Linux desktop.
#
#  Installed as a symlink: $PREFIX/bin/terminux -> <checkout>/bin/terminux.
#  Commands live in lib/<module>.sh as functions named cmd_<command>, loaded
#  on demand. The bin/ + lib/ layout is adapted from ternux; see NOTICE.
#  SPDX-License-Identifier: Apache-2.0
# =============================================================================
set -u

_self="$(readlink -f "${BASH_SOURCE[0]}" 2>/dev/null || echo "${BASH_SOURCE[0]}")"
TX_LIB="$(cd "$(dirname "$_self")/../lib" 2>/dev/null && pwd -P)"
unset _self
[ -f "${TX_LIB:-}/core.sh" ] || { echo "terminux: can't find lib/ next to bin/; reinstall." >&2; exit 1; }

# shellcheck source=lib/core.sh
. "$TX_LIB/core.sh"

tx_use() {
    # shellcheck source=/dev/null
    . "$TX_LIB/$1.sh" || tx_die "internal error: module $1 is missing"
}

# command -> module. Adding a command = a cmd_<name> function plus a line here.
_module_for() {
    case "$1" in
        start|stop|restart|status) echo desktop ;;
        menu)                      echo menu ;;
        debian)                    echo debian ;;
        app)                       echo apps ;;
        info)                      echo info ;;
        banner|login)              echo banner ;;
        help)                      echo help ;;
        *)                         return 1 ;;
    esac
}

case "${1:-help}" in
    -h|--help) set -- help ;;
    -V|--version|version) echo "terminux $TERMINUX_VERSION"; exit 0 ;;
esac

# Plain `terminux` in a terminal opens the menu; anywhere else, help.
if [ $# -eq 0 ]; then
    if { [ -t 0 ] && [ -t 1 ]; } || [ "${TERMINUX_TTY:-0}" = 1 ]; then
        set -- menu
    else
        set -- help
    fi
fi

cmd="$1"
shift
[ "$cmd" = nb ] && cmd=netbird

if ! module="$(_module_for "$cmd")"; then
    tx_fail "unknown command: $cmd"
    echo "Run 'terminux help' for the list of commands." >&2
    exit 2
fi

tx_use "$module"
"cmd_$cmd" "$@"
